# Профиль приложения: dev | stable | dummy
APP_PROFILE=dev

APP_DEBUG=true
APP_PORT=8000

# Приложение (pydantic: APP_ + nested __)
# Docker: postgres (имя сервиса). Локальный запуск без compose: localhost
APP_DATABASE__HOST=postgres
APP_DATABASE__PORT=5432
APP_DATABASE__USER=app
APP_DATABASE__PASSWORD=change_me
APP_DATABASE__NAME=app_dev

# Для `atlas migrate apply --env apply`: обычный postgres:// (не postgresql+asyncpg).
# Пример для локального Postgres без Docker: localhost и те же user/password/db, что выше.
# ATLAS_DATABASE_URL=postgres://app:change_me@localhost:5432/app_dev?sslmode=disable
